# Copy this file to .env and fill in real values.  .env is git-ignored.

# --- LLM (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
# Any Groq model that supports tool calling (llama-3.3-70b-versatile was retired). Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high for reasoning models; leave empty for others
GROQ_REASONING_EFFORT=low

# --- Embeddings (runs locally, no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=drug_labels

# --- Chunking (explained in README "Design decisions") ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- openFDA (optional: raises the rate limit from 1,000 to 120,000 requests/day) ---
# https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- API ---
# Optional: if set, POST /ingest requires the header  X-Admin-Token: <value>
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
